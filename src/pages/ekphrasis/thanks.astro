---
import Base from '../../layouts/Base.astro';
import { PRODUCTS } from '../../lib/products';
---
<Base
  title="Thanks — Chaos of Zen"
  description="Thanks for supporting Ekphrasis. Your download starts automatically."
>
  <h1 data-testid="thanks-heading">Thank you</h1>

  <p>
    Your download should start in a moment. If it doesn't,
    <a href={PRODUCTS.ekphrasis.downloadUrl} data-testid="thanks-download">download Ekphrasis directly</a>.
  </p>

  <p>Your receipt will arrive by email from Lemon Squeezy.</p>

  <p><a href="/ekphrasis/manual">Installation guide</a></p>
</Base>

<script>
  import { PRODUCTS } from '../../lib/products';

  // Best-effort auto-start for the common case; the visible link above is
  // the real fallback for a browser that blocks this navigation.
  window.setTimeout(() => {
    window.location.href = PRODUCTS.ekphrasis.downloadUrl;
  }, 1200);
</script>
