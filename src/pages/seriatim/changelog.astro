---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { entriesFor, changelogAnchor } from '../../lib/changelog';

const allEntries = await getCollection('changelog');
const entries = entriesFor(allEntries, 'seriatim');
const rendered = await Promise.all(entries.map(e => render(e)));
---
<Base
  title="Changelog — Seriatim"
  description="Release history for Seriatim."
>
  <h1>Changelog</h1>
  {entries.map((entry, i) => {
    const { Content } = rendered[i];
    // From the version, not entry.id -- see changelogAnchor's comment.
    const anchor = changelogAnchor(entry.data.version);
    return (
      <section>
        <h2 id={anchor}>{entry.data.version} — {entry.data.title}</h2>
        <p class="text-sm text-ink-muted font-mono !mt-0 !mb-4"><time datetime={entry.data.date}>{entry.data.date}</time></p>
        <Content />
      </section>
    );
  })}
</Base>
