---
import Base from '../../layouts/Base.astro';
import { PRODUCTS } from '../../lib/products';
---
<Base
  title="Thanks — Chaos of Zen"
  description="Thanks for supporting Seriatim. Your download starts automatically."
>
  <h1 data-testid="thanks-heading">Thank you</h1>

  <p>
    Your download should start in a moment. If it doesn't,
    <a href={PRODUCTS.seriatim.downloadUrl} data-testid="thanks-download">download Seriatim directly</a>.
  </p>

  <p>Your receipt will arrive by email from Lemon Squeezy.</p>

  <p><a href="/seriatim/manual">Installation guide</a></p>
</Base>

<script>
  // Read off the product record by key, like every other page. download.ts's
  // bare DOWNLOAD_URL was Seriatim's by convention, which is fine for one
  // product and is exactly the copy-paste that would hand an Ekphrasis buyer
  // Seriatim's dmg.
  import { PRODUCTS } from '../../lib/products';

  // Best-effort auto-start for the common case; the visible link above is
  // the real fallback for a browser that blocks this navigation.
  window.setTimeout(() => {
    window.location.href = PRODUCTS.seriatim.downloadUrl;
  }, 1200);
</script>
