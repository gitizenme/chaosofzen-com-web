---
// "Report an issue" has to name one repository, and this footer renders on
// every page of a site that now serves two products. The repo is derived from
// the path rather than taken as a prop from Base: a prop would have to be
// passed by all thirteen pages, and a page that forgot would silently link to
// the wrong tracker -- which is exactly how the hardcoded url below became
// wrong the moment a second product got pages.
const ISSUE_TRACKERS: Record<string, string> = {
  seriatim: 'https://github.com/gitizenme/seriatim/issues',
  ekphrasis: 'https://github.com/gitizenme/ekphrasis/issues',
};

// The pathname's first segment is the product directory: "/ekphrasis/download"
// -> "ekphrasis". "/" yields "", and so does any non-product page, which is
// what the fallback is for.
const segment = Astro.url.pathname.split('/')[1] ?? '';

// On a product page there is no ambiguity: report against that product.
//
// On a non-product page (/, /eula, /privacy) there is, and it is now a real
// one -- both products ship, so a single link sends half the reports to the
// wrong repository. The earlier note here said to revisit this when Ekphrasis
// shipped and that the honest answer was probably to stop guessing. It has,
// and it is: offer both rather than pick.
const product = ISSUE_TRACKERS[segment];
---
<footer class="mt-24 w-full border-t border-hairline">
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-2 px-6 py-8 text-sm text-ink-muted">
    <p class="!mb-0">© 2026 Chaos of Zen</p>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      <a href="/eula" class="hover:text-ink">Licence</a>
      <a href="/privacy" class="hover:text-ink">Privacy</a>
      {product ? (
        <a href={product} rel="noopener" class="hover:text-ink">Report an issue</a>
      ) : (
        <span class="flex flex-wrap gap-x-2">
          <span>Report an issue:</span>
          <a href={ISSUE_TRACKERS.seriatim} rel="noopener" class="hover:text-ink">Seriatim</a>
          <a href={ISSUE_TRACKERS.ekphrasis} rel="noopener" class="hover:text-ink">Ekphrasis</a>
        </span>
      )}
    </div>
  </div>
</footer>
