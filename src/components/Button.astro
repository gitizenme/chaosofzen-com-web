---
// A discriminated union, not an interface extending both attribute sets:
// `AnchorHTMLAttributes` and `ButtonHTMLAttributes` disagree on `type` (an
// anchor's is a MIME type string; a button's is the "submit"|"reset"|"button"
// union), so merging them with `&` or `extends` widens `type` to a union
// neither side actually accepts. Splitting on `href` keeps each branch typed
// against its own real attribute set.
type Props =
  | ({ href: string } & astroHTML.JSX.AnchorHTMLAttributes)
  | ({ href?: undefined } & astroHTML.JSX.ButtonHTMLAttributes);

const { href, class: className, ...rest } = Astro.props;
const classes = ['btn', className].filter(Boolean).join(' ');
---
{href
  ? <a href={href} class={classes} {...rest as astroHTML.JSX.AnchorHTMLAttributes}><slot /></a>
  : <button class={classes} {...rest as astroHTML.JSX.ButtonHTMLAttributes}><slot /></button>}
